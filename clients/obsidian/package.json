{
  "name": "kwiry-search",
  "version": "0.6.0-beta.25",
  "description": "Obsidian search client with explicit in-plugin lexical and daemon profiles",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:d5c": "node esbuild.config.mjs d5c",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "package:release": "node scripts/production-package.mjs prepare",
    "webdriver:release": "node scripts/webdriver-release-gate.mjs",
    "validate:webdriver:evidence": "node scripts/webdriver-release-gate-schema.mjs",
    "prepare:release:handoff": "node scripts/release-candidate-handoff.mjs prepare",
    "validate:release:handoff": "node scripts/release-candidate-handoff.mjs validate",
    "validate:privacy": "node scripts/privacy-policy.mjs",
    "validate:release:source": "node scripts/production-package.mjs validate-source",
    "package:d5c:brat": "node scripts/package-d5c-brat.mjs",
    "verify:d5c:licenses": "node scripts/validate-d5c-rust-licenses.mjs",
    "verify:docx:licenses": "node scripts/validate-d5c-rust-licenses.mjs docx",
    "verify:docx:parity": "node rust/kwiry-obsidian-wasm/scripts/test-docx.cjs",
    "pretest": "node scripts/prewarm-test-wasm.mjs",
    "test": "node scripts/run-vitest-groups.mjs",
    "pretest:d5c": "node scripts/prewarm-test-wasm.mjs",
    "test:d5c": "vitest run --maxWorkers=2 test/d5c-playground.test.ts test/d5c-preview.test.mjs test/d5c-worker-isolation.test.mjs test/d5c-live-worker.test.mjs test/d5c-live-ui.test.ts test/d5c-heading-position.test.ts test/d5c-brat-package.test.mjs",
    "typecheck": "tsc --noEmit",
    "evidence": "node scripts/gate5-evidence.mjs",
    "validate:evidence": "node scripts/gate5-evidence-schema.mjs",
    "evidence:gate4": "node scripts/gate4-evidence.mjs",
    "corpus:smoke": "node scripts/gate5-corpus-smoke.mjs",
    "performance:gate5": "node --expose-gc scripts/gate5-performance.mjs",
    "test-vault": "node scripts/create-test-vault.mjs",
    "test-vault:smoke": "node scripts/gate5-test-vault-smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:d5c:licenses && npm run verify:docx:licenses && npm run verify:mit:notices && npm run corpus:smoke && npm run build && npm run test-vault:smoke && npm run evidence",
    "verify:mit:notices": "node scripts/verify-mit-notices.mjs",
    "regenerate:d5c:licenses": "node scripts/validate-d5c-rust-licenses.mjs regenerate",
    "regenerate:docx:licenses": "node scripts/validate-d5c-rust-licenses.mjs regenerate docx"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "obsidian-launcher": "3.1.1",
    "selenium-webdriver": "4.39.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1"
  }
}
